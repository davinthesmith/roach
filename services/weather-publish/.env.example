# WeatherLink API Configuration
# Get your API credentials from https://www.weatherlink.com/account
WEATHERLINK_API_KEY=your_api_key_here
WEATHERLINK_API_SECRET=your_api_secret_here
WEATHERLINK_STATION_ID=your_station_id_here

# Kafka Configuration
# For internal Docker communication, use kafka:29092
# For external access, use studio.toomanyprojects.dev:9092
KAFKA_BROKER=kafka:29092

# Weather Service Configuration
FETCH_INTERVAL=5m
LOG_LEVEL=info
