# WeatherLink API
WEATHERLINK_API_KEY=your_api_key_here
WEATHERLINK_API_SECRET=your_api_secret_here
WEATHERLINK_STATION_ID=your_station_id_here

# Kafka
KAFKA_BROKER=kafka:29092

# PostgreSQL (optional)
POSTGRES_DSN=host=postgres port=5432 user=roach password=yourpassword dbname=roach sslmode=disable

# Logging
LOG_LEVEL=info
