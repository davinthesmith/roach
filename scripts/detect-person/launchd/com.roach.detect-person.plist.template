<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roach.detect-person</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ROACH_PROJECT_ROOT__/scripts/detect-person/run/run-daemon.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__ROACH_PROJECT_ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__ROACH_PROJECT_ROOT__/data/logs/detect-person.log</string>
    <key>StandardErrorPath</key>
    <string>__ROACH_PROJECT_ROOT__/data/logs/detect-person.log</string>
</dict>
</plist>
